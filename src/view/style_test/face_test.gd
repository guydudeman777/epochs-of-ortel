extends Control
## Portrait test for faces. Everything here is generated by the simulation's own FaceService.
##
## godot --path . res://src/view/style_test/face_test.tscn --resolution 1800x1050 -- --out=C:/tmp/faces.png
## Options: --view=family (default), beauty, expressions, races, kin, kinbody, kheth, styles, close, body, heights or hair. --seed=number.
## --view=hair shows one style from all round. --hair=style, --beard=style, --tone=0..1, --line=caucasian.
## --sex=male for the expressions and styles sheets.

const RACE_PATH: String = "res://content/defs/races/%s.tres"
## Where a portrait looks, measured from the eyes.
const LOOK_BELOW_EYES: float = 0.037
const CAMERA_BELOW_EYES: float = 0.002
const LINES: Array[StringName] = [&"caucasian", &"asian", &"african"]

var _rng: RandomNumberGenerator = RandomNumberGenerator.new()


func _ready() -> void:
	set_anchors_preset(Control.PRESET_FULL_RECT)
	_rng.seed = ViewUtil.arg("seed", "14").to_int()
	match ViewUtil.arg("view", "family"):
		"beauty":
			_show_beauty()
		"expressions":
			_show_expressions()
		"races":
			_show_races()
		"kin":
			_show_kin()
		"kinbody":
			_show_kin_bodies()
		"kheth":
			_show_kheth()
		"styles":
			_show_styles()
		"close":
			_show_close()
		"body":
			_show_bodies()
		"heights":
			_show_heights()
		"neck":
			_show_necks()
		"armour":
			_show_armour()
		"hair":
			_show_hair()
		_:
			_show_family()
	var out_path: String = ViewUtil.arg("out", "")
	if not out_path.is_empty():
		await ViewUtil.save_shot_and_quit(self, out_path)


func _race(race_id: String) -> RaceDef:
	return load(RACE_PATH % race_id) as RaceDef


func _make_grid(columns: int) -> GridContainer:
	var backdrop: ColorRect = ColorRect.new()
	backdrop.color = Color(0.06, 0.06, 0.065)
	backdrop.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(backdrop)
	var grid: GridContainer = GridContainer.new()
	grid.columns = columns
	grid.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(grid)
	return grid


func _show_family() -> void:
	var grid: GridContainer = _make_grid(3)
	var human: RaceDef = _race("human")
	var line: StringName = LINES[_rng.randi_range(0, LINES.size() - 1)]
	var father: FaceData = FaceService.random_face(_rng, human, true, -1.0, line)
	var mother: FaceData = FaceService.random_face(_rng, human, false, -1.0, line)
	var son: FaceData = FaceService.child_face(_rng, mother, father, true)
	var daughter: FaceData = FaceService.child_face(_rng, mother, father, false)
	_add_portrait(grid, "Father", father, true, 0.3, FaceView.NEUTRAL)
	_add_portrait(grid, "Mother", mother, false, 0.28, FaceView.NEUTRAL)
	_add_portrait(grid, "Unrelated old man", FaceService.random_face(_rng, human, true), true, 0.85, FaceView.NEUTRAL)
	_add_portrait(grid, "Their adult son", son, true, 0.05, FaceView.NEUTRAL)
	_add_portrait(grid, "Their adult daughter", daughter, false, 0.05, FaceView.NEUTRAL)
	_add_portrait(grid, "Unrelated woman", FaceService.random_face(_rng, human, false), false, 0.08, FaceView.NEUTRAL)


## The beauty trait at full strength, across populations. All of them adults.
func _show_beauty() -> void:
	var grid: GridContainer = _make_grid(3)
	var human: RaceDef = _race("human")
	for line: StringName in LINES:
		_add_portrait(grid, "Beautiful woman", FaceService.random_face(_rng, human, false, 1.0, line), false, 0.04, FaceView.NEUTRAL)
	for line: StringName in LINES:
		_add_portrait(grid, "Handsome man", FaceService.random_face(_rng, human, true, 1.0, line), true, 0.06, FaceView.NEUTRAL)


func _show_expressions() -> void:
	var grid: GridContainer = _make_grid(3)
	var male: bool = ViewUtil.arg("sex", "female") == "male"
	var person: FaceData = FaceService.random_face(_rng, _race("human"), male, 0.7, &"caucasian")
	_add_portrait(grid, "Neutral", person, male, 0.06, FaceView.NEUTRAL)
	_add_portrait(grid, "Happy", person, male, 0.06, FaceView.HAPPY)
	_add_portrait(grid, "Laughing", person, male, 0.06, FaceView.LAUGHING)
	_add_portrait(grid, "Angry", person, male, 0.06, FaceView.ANGRY)
	_add_portrait(grid, "Sad", person, male, 0.06, FaceView.SAD)
	_add_portrait(grid, "Shocked", person, male, 0.06, FaceView.SHOCKED)


## What the race settings give: elves, dwarves, orcs, and a half-elf from a human and an elf.
func _show_races() -> void:
	var grid: GridContainer = _make_grid(4)
	var elf: FaceData = FaceService.random_face(_rng, _race("elf"), false)
	var human: FaceData = FaceService.random_face(_rng, _race("human"), true)
	_add_portrait(grid, "Elf woman", elf, false, 0.05, FaceView.NEUTRAL)
	_add_portrait(grid, "Elf man", FaceService.random_face(_rng, _race("elf"), true), true, 0.05, FaceView.NEUTRAL)
	_add_portrait(grid, "Human father", human, true, 0.2, FaceView.NEUTRAL)
	_add_portrait(grid, "Their half-elf son", FaceService.child_face(_rng, elf, human, true), true, 0.05, FaceView.NEUTRAL)
	_add_portrait(grid, "Dwarf woman", FaceService.random_face(_rng, _race("dwarf"), false), false, 0.1, FaceView.NEUTRAL)
	_add_portrait(grid, "Dwarf man", FaceService.random_face(_rng, _race("dwarf"), true), true, 0.25, FaceView.NEUTRAL)
	_add_portrait(grid, "Orc woman", FaceService.random_face(_rng, _race("orc"), false), false, 0.1, FaceView.NEUTRAL)
	_add_portrait(grid, "Orc man", FaceService.random_face(_rng, _race("orc"), true), true, 0.2, FaceView.ANGRY)


## The merrow and the kheth, from the front, the side and above, to check their features sit on the head.
func _show_kin() -> void:
	var grid: GridContainer = _make_grid(4)
	for race_id: String in ["merrow", "kheth"]:
		var woman: FaceData = FaceService.random_face(_rng, _race(race_id), false)
		var man: FaceData = FaceService.random_face(_rng, _race(race_id), true)
		var title: String = race_id.capitalize()
		_add_portrait(grid, title + " woman", woman, false, 0.1, FaceView.NEUTRAL, 1.6, 16.0)
		_add_portrait(grid, title + " man", man, true, 0.2, FaceView.ANGRY, 1.6, 30.0)
		_add_portrait(grid, title + " man, side", man, true, 0.2, FaceView.NEUTRAL, 1.6, 85.0)
		_add_portrait(grid, title + " woman, behind", woman, false, 0.1, FaceView.NEUTRAL, 1.6, 150.0, 0.25)


## Every hair and beard style on one person, to check that none of them hide the face.
func _show_styles() -> void:
	var male: bool = ViewUtil.arg("sex", "female") == "male"
	var grid: GridContainer = _make_grid(7)
	var base: FaceData = FaceService.random_face(_rng, _race("human"), male, 0.6, &"caucasian")
	var styles: Array[StringName] = []
	styles.assign(FaceService.MALE_HAIR if male else FaceService.FEMALE_HAIR)
	styles.append_array(FaceService.AFRO_LINE_HAIR)
	for style: StringName in styles:
		var person: FaceData = base.duplicate() as FaceData
		person.hair_style = style
		person.beard_style = &""
		_add_portrait(grid, String(style).trim_prefix("elvs_"), person, male, 0.06, FaceView.NEUTRAL, 1.35)
	if male:
		for style: StringName in FaceService.BEARDS:
			var bearded: FaceData = base.duplicate() as FaceData
			bearded.beard_style = style
			_add_portrait(grid, String(style).left(24), bearded, male, 0.2, FaceView.NEUTRAL, 1.35)


## One hair style and one beard, from all round and from above.
func _show_hair() -> void:
	var male: bool = ViewUtil.arg("sex", "male") == "male"
	var grid: GridContainer = _make_grid(4)
	var line: StringName = StringName(ViewUtil.arg("line", "caucasian"))
	var person: FaceData = FaceService.random_face(_rng, _race("human"), male, 0.6, line)
	person.hair_style = StringName(ViewUtil.arg("hair", String(person.hair_style)))
	person.beard_style = StringName(ViewUtil.arg("beard", ""))
	person.hair_tone = ViewUtil.arg("tone", "0.45").to_float()
	var zoom: float = ViewUtil.arg("zoom", "0.75").to_float()
	var views: Array[Vector2] = [Vector2(16.0, 0.0), Vector2(65.0, 0.0), Vector2(-40.0, -0.1), Vector2(180.0, 0.0), Vector2(125.0, 0.15), Vector2(10.0, 0.75), Vector2(180.0, 0.75), Vector2(90.0, 0.9)]
	for view: Vector2 in views:
		_add_portrait(grid, "%d deg" % int(view.x), person, male, 0.15, FaceView.NEUTRAL, zoom, view.x, view.y)


func _show_close() -> void:
	var grid: GridContainer = _make_grid(2)
	var person: FaceData = FaceService.random_face(_rng, _race("human"), false, 0.9, &"caucasian")
	_add_portrait(grid, "Close, three-quarter", person, false, 0.05, FaceView.NEUTRAL, 0.62, 28.0)
	_add_portrait(grid, "Close, profile", person, false, 0.05, FaceView.NEUTRAL, 0.62, 68.0)


func _show_bodies() -> void:
	var grid: GridContainer = _make_grid(1)
	var world: SubViewport = _add_viewport(grid, "Commoner, soldier bareheaded, soldier helmeted, crowd soldier, woman commoner, woman soldier")
	var human: RaceDef = _race("human")
	var man: FaceData = FaceService.random_face(_rng, human, true, 0.5, &"caucasian")
	var woman: FaceData = FaceService.random_face(_rng, human, false, 0.5, &"asian")
	_add_dressed(world, man, true, 0.2, -2.5, BodyView.COMMONER, false, false, &"idle_unarmed")
	_add_dressed(world, man, true, 0.2, -1.5, BodyView.SOLDIER, false, false)
	_add_dressed(world, man, true, 0.2, -0.5, BodyView.SOLDIER, true, false)
	_add_dressed(world, man, true, 0.2, 0.5, BodyView.SOLDIER, true, true)
	_add_dressed(world, woman, false, 0.2, 1.5, BodyView.COMMONER, false, false, &"idle_unarmed")
	_add_dressed(world, woman, false, 0.2, 2.5, BodyView.SOLDIER, true, false)
	_add_lighting(world)
	var camera: Camera3D = Camera3D.new()
	camera.fov = 30.0
	world.add_child(camera)
	camera.look_at_from_position(Vector3(0.0, 1.1, 7.6), Vector3(0.0, 0.92, 0.0), Vector3.UP)


## The kheth up close from all round, then five of them in each colouring, front and back.
func _show_kheth() -> void:
	var grid: GridContainer = _make_grid(4)
	var race: RaceDef = _race("kheth")
	var man: FaceData = FaceService.random_face(_rng, race, true)
	_add_portrait(grid, "Front", man, true, 0.2, FaceView.NEUTRAL, 1.7, 0.0)
	_add_portrait(grid, "Three quarters", man, true, 0.2, FaceView.NEUTRAL, 1.7, 35.0)
	_add_portrait(grid, "Side", man, true, 0.2, FaceView.NEUTRAL, 1.7, 90.0)
	_add_portrait(grid, "Behind", man, true, 0.2, FaceView.NEUTRAL, 1.7, 160.0, 0.2)
	for turn: float in [20.0, 200.0]:
		var world: SubViewport = _add_viewport(grid, "Each colouring" if turn < 90.0 else "From behind")
		for i: int in range(5):
			var person: FaceData = FaceService.random_face(_rng, race, i % 2 == 0)
			person.skin_variant = i
			_add_dressed(world, person, i % 2 == 0, 0.2, -2.0 + i, BodyView.SOLDIER if i == 2 else BodyView.COMMONER, false, false,
				&"idle" if i == 2 else &"idle_unarmed")
			(world.get_child(world.get_child_count() - 1) as Node3D).rotation_degrees.y = turn
		_add_lighting(world)
		var camera: Camera3D = Camera3D.new()
		camera.fov = 30.0
		world.add_child(camera)
		camera.look_at_from_position(Vector3(0.0, 1.0, 6.2), Vector3(0.0, 0.92, 0.0), Vector3.UP)


## A man beside the merrow and the kheth, in plain clothes and armed, and a kheth turned side on.
func _show_kin_bodies() -> void:
	var grid: GridContainer = _make_grid(1)
	var world: SubViewport = _add_viewport(grid, "Human, merrow, merrow soldier, kheth, kheth soldier, kheth from the side")
	var man: FaceData = FaceService.random_face(_rng, _race("human"), true, 0.5, &"caucasian")
	var merrow: FaceData = FaceService.random_face(_rng, _race("merrow"), true)
	var kheth: FaceData = FaceService.random_face(_rng, _race("kheth"), true)
	_add_dressed(world, man, true, 0.2, -2.5, BodyView.COMMONER, false, false, &"idle_unarmed")
	_add_dressed(world, merrow, true, 0.2, -1.5, BodyView.COMMONER, false, false, &"idle_unarmed")
	_add_dressed(world, merrow, true, 0.2, -0.5, BodyView.SOLDIER, false, false)
	_add_dressed(world, kheth, true, 0.2, 0.5, BodyView.COMMONER, false, false, &"idle_unarmed")
	_add_dressed(world, kheth, true, 0.2, 1.5, BodyView.SOLDIER, false, false)
	_add_dressed(world, kheth, true, 0.2, 2.5, BodyView.COMMONER, false, false, &"idle_unarmed")
	(world.get_child(world.get_child_count() - 1) as Node3D).rotation_degrees.y = 90.0
	_add_lighting(world)
	var camera: Camera3D = Camera3D.new()
	camera.fov = 30.0
	world.add_child(camera)
	camera.look_at_from_position(Vector3(0.0, 1.1, 7.6) * ViewUtil.arg("zoom", "1").to_float(), Vector3(0.0, 0.92, 0.0), Vector3.UP)


## Everyone stands on the same ground at their own height.
func _show_heights() -> void:
	var grid: GridContainer = _make_grid(1)
	var world: SubViewport = _add_viewport(grid, "Each population, woman and man, young and old")
	var human: RaceDef = _race("human")
	var x: float = -3.15
	for line: StringName in LINES:
		for male: bool in [false, true]:
			for age: float in [0.1, 0.9]:
				var person: FaceData = FaceService.random_face(_rng, human, male, 0.5, line)
				_add_dressed(world, person, male, age, x, BodyView.COMMONER, false, false, &"idle_unarmed")
				x += 0.57
	_add_lighting(world)
	var camera: Camera3D = Camera3D.new()
	camera.fov = 24.0
	world.add_child(camera)
	camera.look_at_from_position(Vector3(0.0, 0.9, 9.5), Vector3(0.0, 0.9, 0.0), Vector3.UP)


## Close on the join between head and body, on several bodies and in a bent pose.
func _show_necks() -> void:
	var grid: GridContainer = _make_grid(3)
	var human: RaceDef = _race("human")
	for line: StringName in LINES:
		for male: bool in [false, true]:
			var person: FaceData = FaceService.random_face(_rng, human, male, 0.5, line)
			var world: SubViewport = _add_viewport(grid, "%s %s" % [line, "man" if male else "woman"])
			var body: Node3D = BodyView.make(person, male, 0.15, [] as Array[String])
			world.add_child(body)
			FaceView.attach(body, person, male, 0.15)
			ViewUtil.play(body, &"idle_unarmed", true)
			_add_lighting(world)
			var camera: Camera3D = Camera3D.new()
			camera.fov = 20.0
			world.add_child(camera)
			var eyes: float = BodyView.eye_height(ViewUtil.find_skeleton(body))
			camera.look_at_from_position(Vector3(-0.3, eyes - 0.1, 0.8), Vector3(0.0, eyes - 0.19, 0.0), Vector3.UP)


## Close on one soldier from four sides, to check how the gear fits.
func _show_armour() -> void:
	var grid: GridContainer = _make_grid(4)
	var person: FaceData = FaceService.random_face(_rng, _race("human"), ViewUtil.arg("sex", "male") == "male", 0.5, &"caucasian")
	var male: bool = ViewUtil.arg("sex", "male") == "male"
	for yaw: float in [10.0, 80.0, 180.0, -70.0]:
		var world: SubViewport = _add_viewport(grid, "From %d degrees" % int(yaw))
		_add_dressed(world, person, male, 0.15, 0.0, BodyView.SOLDIER, true, false)
		_add_lighting(world)
		var camera: Camera3D = Camera3D.new()
		camera.fov = 36.0
		world.add_child(camera)
		var angle: float = deg_to_rad(yaw)
		camera.look_at_from_position(Vector3(sin(angle) * 2.0, 1.25, cos(angle) * 2.0), Vector3(0.0, 1.15, 0.0), Vector3.UP)


func _add_dressed(world: SubViewport, face: FaceData, male: bool, age: float, x: float, worn: Array[String], helmet: bool, crowd: bool, clip: StringName = &"idle") -> void:
	var clothes: Array[String] = worn.duplicate()
	if helmet:
		clothes.append_array(BodyView.HELMET)
	var body: Node3D = BodyView.make(face, male, age, clothes, crowd)
	world.add_child(body)
	body.position.x = x
	if not crowd:
		var head: Node3D = FaceView.attach(body, face, male, age)
		if helmet:
			FaceView.hide_hair(head)
	ViewUtil.play(body, clip, true)


func _add_portrait(grid: GridContainer, title: String, face: FaceData, male: bool, age: float, expression: Dictionary[StringName, float], zoom: float = 1.0, yaw_degrees: float = 16.0, rise: float = 0.0) -> void:
	var world: SubViewport = _add_viewport(grid, title)
	var body: Node3D = BodyView.make(face, male, age, BodyView.COMMONER)
	world.add_child(body)
	var head: Node3D = FaceView.attach(body, face, male, age)
	FaceView.set_expression(head, expression)
	ViewUtil.play(body, &"idle_unarmed", true)
	_add_lighting(world)
	var camera: Camera3D = Camera3D.new()
	camera.fov = 21.0
	world.add_child(camera)
	var eyes: float = BodyView.eye_height(ViewUtil.find_skeleton(body))
	var yaw: float = deg_to_rad(yaw_degrees)
	var distance: float = 1.0 * zoom
	var from: Vector3 = Vector3(sin(yaw) * distance, eyes - CAMERA_BELOW_EYES + rise * distance, cos(yaw) * distance)
	camera.look_at_from_position(from, Vector3(0.0, eyes - LOOK_BELOW_EYES, 0.0), Vector3.UP)


func _add_viewport(grid: GridContainer, title: String) -> SubViewport:
	var cell: VBoxContainer = VBoxContainer.new()
	cell.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	cell.size_flags_vertical = Control.SIZE_EXPAND_FILL
	grid.add_child(cell)
	var holder: SubViewportContainer = SubViewportContainer.new()
	holder.stretch = true
	holder.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	holder.size_flags_vertical = Control.SIZE_EXPAND_FILL
	cell.add_child(holder)
	var world: SubViewport = SubViewport.new()
	world.own_world_3d = true
	world.msaa_3d = Viewport.MSAA_4X
	holder.add_child(world)
	var label: Label = Label.new()
	label.text = title
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	cell.add_child(label)
	return world


func _add_lighting(world: SubViewport) -> void:
	var key: DirectionalLight3D = DirectionalLight3D.new()
	key.rotation_degrees = Vector3(-26.0, 34.0, 0.0)
	key.light_color = Color(1.0, 0.95, 0.9)
	key.light_energy = 0.76
	key.shadow_enabled = true
	key.directional_shadow_max_distance = 12.0
	world.add_child(key)
	var fill: DirectionalLight3D = DirectionalLight3D.new()
	fill.rotation_degrees = Vector3(-4.0, -50.0, 0.0)
	fill.light_color = Color(0.72, 0.78, 0.92)
	fill.light_energy = 0.34
	world.add_child(fill)
	var environment: Environment = Environment.new()
	environment.background_mode = Environment.BG_COLOR
	environment.background_color = Color(0.09, 0.09, 0.1)
	environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	environment.ambient_light_color = Color(0.62, 0.62, 0.66)
	environment.ambient_light_energy = 0.38
	environment.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	environment.ssao_enabled = true
	environment.ssao_radius = 0.1
	environment.ssao_intensity = 1.2
	var holder: WorldEnvironment = WorldEnvironment.new()
	holder.environment = environment
	world.add_child(holder)
