class_name EventHub
extends Node

## All cross-system communication. Payloads are ids, so they stay valid data.
signal day_advanced(day: int)
signal character_born(character_id: int)
signal character_died(character_id: int, cause: StringName)
signal character_wounded(character_id: int, part_id: StringName, level: SimEnums.WoundLevel)
signal limb_lost(character_id: int, part_id: StringName)
signal marriage_formed(a_id: int, b_id: int)
signal player_character_changed(old_id: int, new_id: int)
signal player_line_ended(last_id: int)
signal ruler_changed(faction_id: int, old_id: int, new_id: int)
signal character_enslaved(character_id: int, origin: SimEnums.BondageOrigin)
signal character_freed(character_id: int, reason: StringName)
signal pop_enslaved(settlement_id: int, race_id: StringName, count: int, origin: SimEnums.BondageOrigin)
signal pop_freed(settlement_id: int, race_id: StringName, count: int, reason: StringName)
signal pop_escaped(settlement_id: int, race_id: StringName, count: int)
signal captives_sold(settlement_id: int, race_id: StringName, count: int, gold: int)
signal revolt_started(settlement_id: int, race_id: StringName, rebels: int)
signal revolt_ended(settlement_id: int, rebels_won: bool)
signal settlement_founded(settlement_id: int)
## The land around a settlement has changed: woods felled or grown back, or the town is new.
signal land_changed(settlement_id: int)
signal settlement_captured(settlement_id: int, old_faction_id: int, new_faction_id: int)
signal settlement_raided(settlement_id: int, warband_id: int)
signal faction_founded(faction_id: int)
signal faction_destroyed(faction_id: int)
signal realm_split(new_faction_id: int, old_faction_id: int)
signal war_declared(a_id: int, b_id: int)
signal peace_made(a_id: int, b_id: int)
signal law_changed(faction_id: int, what: StringName)
signal tech_discovered(faction_id: int, tech_id: StringName)
signal battle_resolved(winner_label: String, loser_label: String, settlement_id: int)
## Who beat whom, by band id. Sent with battle_resolved whenever both sides were bands. -1 for a side with no band.
signal band_beaten(winner_band_id: int, loser_band_id: int)
signal business_founded(business_id: int)
signal warband_formed(warband_id: int)
signal warband_destroyed(warband_id: int)
signal warband_arrived(warband_id: int, settlement_id: int)
signal encounter_started(player_band_id: int, other_band_id: int)
signal encounter_ended(other_band_id: int)
